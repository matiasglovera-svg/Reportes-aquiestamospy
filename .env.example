# Copiar a .env.local (desarrollo) y cargar los mismos valores en Vercel → Settings → Environment Variables.
# Nunca subir .env.local al repo.

# Microsoft (Azure / Entra ID) — app "Reportes-AquiEstamos"
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# En local usar: http://localhost:3000/api/microsoft/callback
MS_REDIRECT_URI=https://reportes-aquiestamospy.vercel.app/api/microsoft/callback

# Sesión: 32+ caracteres aleatorios  →  npm run gen-secrets
SESSION_SECRET=
# 32 bytes en base64 (AES-256-GCM para el refresh token)  →  npm run gen-secrets
TOKEN_ENCRYPTION_KEY=

# Usuarios. Generar cada hash con: npm run hash-password
# En Vercel el hash va tal cual. En .env.local hay que escapar cada $ del hash como \$ (el script muestra las dos formas).
APP_USERS=[{"user":"matias","hash":"<bcrypt>","role":"admin"},{"user":"ariel","hash":"<bcrypt>","role":"viewer"}]

# Upstash Redis (las crea Vercel al conectar la integración)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

APP_TIMEZONE=America/Asuncion
